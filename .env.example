# Neo4j Aura or local Neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j
CREMORNE_AUTO_SEED=true
CREMORNE_ROOM_ISSUE_THRESHOLD=3

# OpenAI-compatible Structured Outputs endpoint
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=2200
LLM_MODEL=gpt-4o-mini
# Optional. Keep false for the live demo: NLU still uses the LLM, while
# explanations are generated immediately from retrieved graph evidence.
LLM_EXPLANATIONS=false

