{
  "name": "cremorne-memory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "qr": "node ./scripts/generate-qr.mjs",
    "data:build": "node ./scripts/build-cremorne-data.mjs",
    "graph:seed": "node --import tsx ./scripts/seed-neo4j.ts",
    "graph:verify-candidate": "node --import tsx ./scripts/verify-candidate-route-flow.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "neo4j-driver": "^6.0.0",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/leaflet": "^1.9.22",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.71.0",
    "vitest": "latest"
  }
}
